// Build file for RAG System Service
java_library {
    name: "services.rag",
    srcs: [
        "*.java",
        "core/*.java",
        "inference/*.java",
        "indexing/*.java",
        "search/*.java",
        "tools/*.java",
        "model/*.java",
    ],
    static_libs: [
        "objectbox-android",
        "objectbox-java",
        "androidx.work_work-runtime",
    ],
    libs: [
        "services.core",
        "framework",
    ],
}
