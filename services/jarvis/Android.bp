// Build file for the JarvisOS system service.
//
// Lives in services/jarvis/ (not under services/core/java/...) on purpose:
// services.core globs services/core/java/**/*.java, so anything under that
// tree is compiled into services.core, which has no ObjectBox on its classpath.
//
// The ObjectBox *_ and *Cursor classes and MyObjectBox are generated, but not
// by this build: run objectbox/regenerate.sh after changing an @Entity class
// and commit its output. objectbox/test.sh checks the result on the host.
package {
    default_applicable_licenses: ["frameworks_base_license"],
}

java_library_static {
    name: "services.jarvis",
    defaults: ["platform_service_defaults"],
    srcs: ["java/**/*.java"],
    // objectbox-android (LiveData/Paging helpers) is deliberately not linked:
    // it needs androidx and nothing in the service uses it.
    static_libs: [
        "objectbox-java",
        "jsr305",
    ],
    libs: ["services.core"],
}
